options:
    p: &8[&6AutoComp&8]
    owner: benjighg9147
    c_name: &6&lMulti-Compressor
    
    # GUI Namen
    t_hub: &8» &6AutoComp Menü
    t_list: &8» &6Kategorien Liste
    t_setup: &8» &6Setup: &b

# --- 1. FUNKTIONEN ---

function ac_open_hub(p: player):
    set {_gui} to chest inventory with 3 rows named "{@t_hub}"
    set metadata tag "ac_menu" of p to "hub"
    loop 27 times:
        set slot (loop-number - 1) of {_gui} to gray stained glass pane named " "
    
    set slot 11 of {_gui} to minecart with hopper named "&e&lITEM ERSTELLEN" with lore "&7Klicke hier, um den", "&7Namen einzugeben."
    
    if name of p is "{@owner}":
        set slot 15 of {_gui} to chest named "&b&lVERWALTEN" with lore "&7Kategorien löschen", "&7oder neue erstellen."
    else:
        set slot 15 of {_gui} to barrier named "&c&lLOCKED" with lore "&7Nur für {@owner}"
        
    open {_gui} to p

function ac_open_list(p: player):
    set {_gui} to chest inventory with 6 rows named "{@t_list}"
    set metadata tag "ac_menu" of p to "list"
    
    set {_s} to 0
    loop {comp_categories::*}:
        set slot {_s} of {_gui} to book named "&e%loop-value%" with lore "&7Kategorie: &8%loop-value%", "&f", "&7Rechtsklick: &c&lLÖSCHEN"
        add 1 to {_s}
    
    set slot 49 of {_gui} to anvil named "&a&lNEUE KATEGORIE" with lore "&7Klicke hier, um eine", "&7neue Kategorie zu erstellen."
    set slot 53 of {_gui} to barrier named "&c&lZURÜCK"
    open {_gui} to p

function ac_open_setup(p: player, cat: text):
    set {_gui} to chest inventory with 5 rows named "{@t_setup}%{_cat}%"
    set metadata tag "ac_menu" of p to "setup"
    set metadata tag "ac_cat" of p to {_cat}
    
    loop 45 times:
        set slot (loop-number - 1) of {_gui} to gray stained glass pane named " "
    
    set slot 20 of {_gui} to air 
    set slot 24 of {_gui} to air 
    set slot 40 of {_gui} to lime wool named "&a&lSPEICHERN"
    set slot 44 of {_gui} to barrier named "&c&lABBRECHEN"
    open {_gui} to p

function ac_open_selector(p: player):
    set {_gui} to chest inventory with 6 rows named "&8» &6Wähle Kategorien"
    set metadata tag "ac_menu" of p to "selector"
    set {_item} to p's tool
    set {_lore} to "%lore of {_item}%"
    set {_s} to 0
    loop {comp_categories::*}:
        if {_lore} contains "%loop-value%":
            set slot {_s} of {_gui} to lime dye named "&a&l%loop-value%" with lore "&7Status: &aAN"
        else:
            set slot {_s} of {_gui} to gray dye named "&7&l%loop-value%" with lore "&7Status: &cAUS"
        add 1 to {_s}
    open {_gui} to p

# --- 2. COMMAND ---

command /autocomp:
    trigger:
        if name of player is not "{@owner}":
            send "{@p} &cDieser Befehl ist nur für {@owner}"
            stop
        ac_open_hub(player)

# --- 3. KLICK LOGIK (DER WICHTIGE TEIL) ---

on inventory click:
    set {_tag} to metadata tag "ac_menu" of player
    if {_tag} is not set:
        stop
    
    # --- SETUP FIX ANFANG ---
    # Hier erlauben wir das Klicken im Setup-Menü VOR dem Cancel Event
    if {_tag} is "setup":
        # Wenn man ins eigene Inventar klickt -> Erlauben
        if clicked inventory is player's inventory:
            uncancel event
            stop
        # Wenn man auf Slot 20 oder 24 klickt -> Erlauben
        if index of event-slot is 20 or 24:
            uncancel event
            stop
    # --- SETUP FIX ENDE ---

    cancel event # Alles andere wird blockiert
    
    # === HUB ===
    if {_tag} is "hub":
        if index of event-slot is 11:
            set {ac_chat_rename::%player's uuid%} to true
            close player's inventory
            send "{@p} &6Schreibe den Namen für das Item in den Chat!"
        
        if index of event-slot is 15:
            if name of player is "{@owner}":
                ac_open_list(player)
            else:
                send "{@p} &cDas darf nur der Owner."

    # === LISTE ===
    if {_tag} is "list":
        if event-item is book:
            if click type is right mouse button:
                if name of player is "{@owner}":
                    set {_l::*} to lore of event-item
                    set {_cat_raw} to {_l::1}
                    replace all "&7Kategorie: &8" with "" in {_cat_raw}
                    
                    delete {comp_in::%{_cat_raw}%::*}, {comp_out::%{_cat_raw}%::*}, {recipe_count::%{_cat_raw}%}
                    remove {_cat_raw} from {comp_categories::*}
                    
                    send "{@p} &cKategorie '%{_cat_raw}%' gelöscht!"
                    play sound "block.lava.extinguish" to player
                    ac_open_list(player)
        
        if index of event-slot is 49:
            if name of player is "{@owner}":
                set {ac_chat_newcat::%player's uuid%} to true
                close player's inventory
                send "{@p} &6Name der neuen Kategorie in den Chat schreiben!"
        
        if index of event-slot is 53:
            ac_open_hub(player)

    # === SETUP SPEICHERN ===
    if {_tag} is "setup":
        if index of event-slot is 40: # Speichern Button
            if name of player is not "{@owner}":
                send "{@p} &cNur {@owner} kann Rezepte erstellen."
                stop
            set {_cat} to metadata tag "ac_cat" of player
            set {_in} to slot 20 of event-inventory
            set {_out} to slot 24 of event-inventory
            
            if {_in} is not air:
                if {comp_categories::*} does not contain {_cat}:
                    add {_cat} to {comp_categories::*}
                
                add 1 to {recipe_count::%{_cat}%}
                set {comp_in::%{_cat}%::%{recipe_count::%{_cat}%}%} to {_in}
                set {comp_out::%{_cat}%::%{recipe_count::%{_cat}%}%} to {_out}
                
                send "{@p} &aRezept gespeichert!"
                set slot 20 of event-inventory to air
                set slot 24 of event-inventory to air
                play sound "block.note_block.pling" to player
            else:
                send "{@p} &cInput Item fehlt!"

        if index of event-slot is 44:
            ac_open_list(player)

    # === SELECTOR ===
    if {_tag} is "selector":
        if event-item is lime dye or gray dye:
            set {_cat} to uncolored name of event-item
            set {_item} to player's tool
            set {_l::*} to lore of {_item}
            
            set {_found} to false
            loop {_l::*}:
                if loop-value contains {_cat}:
                    remove loop-value from {_l::*}
                    set {_found} to true
            
            if {_found} is false:
                remove "&8- &7(Keine)" from {_l::*}
                add "&8- &e%{_cat}%" to {_l::*}
            
            if size of {_l::*} < 4:
                add "&8- &7(Keine)" to {_l::*}

            set lore of {_item} to {_l::*}
            set player's tool to {_item}
            wait 1 tick
            ac_open_selector(player)

# --- 4. CHAT INPUTS ---

on chat:
    # Item Benennen
    if {ac_chat_rename::%player's uuid%} is set:
        cancel event
        delete {ac_chat_rename::%player's uuid%}
        set {_name} to colored message
        set {_i} to minecart with hopper named {_name}
        set lore of {_i} to "&7Status: &c&lAUS", "&f", "&6Aktive Kategorien:", "&8- &7(Keine)", "&f", "&eSneak + Rechts: &aAn/Aus", "&eSneak + Links: &bKategorien"
        give {_i} to player
        send "{@p} &aItem erhalten: %{_name}%"
        stop

    # Neue Kategorie
    if {ac_chat_newcat::%player's uuid%} is set:
        cancel event
        delete {ac_chat_newcat::%player's uuid%}
        if message is "abbruch":
            ac_open_list(player)
            stop
        set {_name} to uncolored message
        wait 1 tick
        ac_open_setup(player, {_name})

# --- 5. CLEANUP ---

on inventory close:
    if metadata tag "ac_menu" of player is "setup":
        # Items zurückgeben, damit sie nicht verloren gehen
        if slot 20 of player's open inventory is not air:
            give slot 20 of player's open inventory to player
        if slot 24 of player's open inventory is not air:
            give slot 24 of player's open inventory to player
    delete metadata tag "ac_menu" of player
    delete metadata tag "ac_cat" of player

# --- 6. INTERAKTIONEN ---

on leftclick:
    if player is sneaking:
        if lore of player's tool contains "&eSneak + Links: &bKategorien":
            cancel event
            if name of player is "{@owner}":
                ac_open_selector(player)
            else:
                send "{@p} &cDu darfst die Kategorien nicht ändern!" to player

on rightclick:
    if player is sneaking:
        if lore of player's tool contains "&eSneak + Rechts: &aAn/Aus":
            cancel event
            set {_l::*} to lore of player's tool
            if {_l::1} contains "AUS":
                set {_l::1} to "&7Status: &a&lAN"
                send action bar "&a&lAutoComp aktiviert" to player
            else:
                set {_l::1} to "&7Status: &c&lAUS"
                send action bar "&c&lAutoComp deaktiviert" to player
            set lore of player's tool to {_l::*}
            play sound "block.iron_trapdoor.open" to player

# --- 7. TURBO LOOP ---

every 1 second:
    loop all players:
        set {_off} to loop-player's offhand tool
        if lore of {_off} contains "Status: &a&lAN":
            loop lore of {_off}:
                if loop-value-2 contains "&8- &e":
                    set {_cat} to loop-value-2
                    replace all "&8- &e" with "" in {_cat}
                    
                    loop {comp_in::%{_cat}%::*}:
                        set {_i} to loop-index
                        set {_in} to {comp_in::%{_cat}%::%{_i}%}
                        set {_out} to {comp_out::%{_cat}%::%{_i}%}
                        
                        set {_req} to item amount of {_in}
                        if amount of {_in} in loop-player's inventory >= {_req}:
                            set {_m} to floor(amount of {_in} in loop-player's inventory / {_req})
                            remove ({_m} * {_req}) of {_in} from loop-player's inventory
                            give ({_m} * item amount of {_out}) of {_out} to loop-player
