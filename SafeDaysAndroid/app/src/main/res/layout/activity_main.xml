<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="24dp"
            android:paddingBottom="18dp">
            <TextView
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:gravity="center"
                android:text="🍃"
                android:textSize="34sp"
                android:background="@drawable/circle_glass"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Schritt für Schritt"
                android:textSize="23sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Heute zählt genauso wie morgen."
                android:textSize="15sp"
                android:textColor="#80000000"/>
        </LinearLayout>

        <include
            android:id="@+id/self_harm_card"
            layout="@layout/counter_card"/>

        <include
            android:id="@+id/alcohol_card"
            layout="@layout/counter_card"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Deine Daten bleiben lokal auf diesem Gerät."
            android:textSize="13sp"
            android:textColor="#80000000"/>
    </LinearLayout>
</ScrollView>
